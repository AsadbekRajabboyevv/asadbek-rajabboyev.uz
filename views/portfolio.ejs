<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="<%= (settings && settings.theme) ? settings.theme : 'cyber_dark' %>">
<head>
    <%- include('partials/head') %>
</head>
<body class="text-slate-100 antialiased overflow-x-hidden">
    <div id="scroll-progress"></div>
    <button id="back-to-top" aria-label="Back to top"><i class="fas fa-chevron-up"></i></button>
    <div id="cursor-glow"></div>
    <%- include('partials/birthday') %>
    <%- include('partials/header') %>

    <!-- HOME SECTION -->
    <section id="home" class="gradient-bg text-white min-h-screen flex items-center pt-16 relative overflow-hidden">
        <div class="container mx-auto px-4 py-16 md:py-32 relative z-20">
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 text-center md:text-left mb-10 md:mb-0">
                    <h1 class="text-4xl md:text-6xl font-extrabold mb-4 leading-tight">
                        <span><%= t.helloIm %></span>
                        <span class="block text-accent mt-2"><%= settings.full_name %></span>
                    </h1>
                    <p class="text-xl md:text-2xl mb-8 font-light text-slate-300">
                        <span class="typing-text"><%= settings['job_title_' + lang] %></span>
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
                        <a href="#contact" class="bg-accent hover:opacity-90 text-white font-bold py-3.5 px-8 rounded-full transition-all duration-300 text-center shadow-lg shadow-blue-600/30"><%= t.contactMe %></a>
                        <a href="#about" class="bg-transparent hover:bg-white/10 text-white font-bold py-3.5 px-8 rounded-full border border-white/20 transition-all duration-300 text-center backdrop-blur-sm"><%= t.aboutMe %></a>
                    </div>
                </div>
                <div class="md:w-1/2 flex justify-center reveal-scale">
                    <img src="/uploads/<%= settings.profile_image %>" class="w-64 h-64 md:w-80 md:h-80 object-cover object-center rounded-3xl border-2 border-white/10 shadow-2xl animate-float" alt="<%= settings.full_name %>">
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section id="about" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-accent reveal"><%= t.aboutMe %></h2>
            <div class="flex flex-col md:flex-row items-stretch gap-8">
                <div class="md:w-1/3 reveal-left">
                    <div class="glass-card p-8 rounded-3xl h-full space-y-4">
                        <h3 class="text-xl font-bold mb-4 text-white border-b border-white/10 pb-3"><%= t.personalInfo %></h3>
                        <ul class="space-y-3 text-sm text-slate-300">
                            <li class="flex items-center gap-2"><span class="font-semibold text-accent"><%= t.name %>:</span> <span><%= settings.full_name %></span></li>
                            <li class="flex items-center gap-2"><span class="font-semibold text-accent"><%= t.born %>:</span> <span><%= settings.birth_date %></span></li>
                            <li class="flex items-center gap-2"><span class="font-semibold text-accent"><%= t.location %>:</span> <a href="<%= settings.location_url %>" target="_blank" class="text-accent hover:underline"><%= settings['location_' + lang] %></a></li>
                            <li class="flex items-center gap-2"><span class="font-semibold text-accent"><%= t.currentJob %>:</span> <a href="<%= settings.company_url %>" target="_blank" class="text-accent hover:underline"><%= settings.current_company %></a></li>
                            <li class="flex items-center gap-2"><span class="font-semibold text-accent"><%= t.positionLabel %>:</span> <span><%= settings['position_' + lang] %></span></li>
                        </ul>
                    </div>
                </div>
                <div class="md:w-2/3 reveal-right space-y-4">
                    <% about.forEach((p, i) => { %>
                        <div class="glass-panel p-6 rounded-2xl border border-white/5">
                            <p class="text-slate-300 leading-relaxed text-base"><%= p['text_' + lang] %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>

    <!-- SKILLS SECTION -->
    <section id="skills" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-accent reveal"><%= t.skills %></h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% skills.forEach((skill, i) => { %>
                    <div class="skill-card glass-card p-6 rounded-2xl reveal stagger-<%= (i % 12) + 1 %>">
                        <div class="text-accent text-4xl mb-4"><i class="<%= skill.icon_class %>"></i></div>
                        <h3 class="text-lg font-bold mb-3 text-white"><%= skill.name %></h3>
                        <div class="w-full bg-white/10 rounded-full h-2.5 overflow-hidden">
                            <div class="skill-bar-fill bg-accent h-2.5 rounded-full" style="--target-width:<%= skill.percentage %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- PROJECTS SECTION -->
    <section id="projects" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-accent reveal"><%= t.projects %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% projects.forEach((project, i) => { %>
                    <div class="project-card-wrapper glass-card rounded-3xl overflow-hidden reveal stagger-<%= (i % 12) + 1 %> flex flex-col justify-between">
                        <div>
                            <div class="relative project-card overflow-hidden">
                                <img src="/uploads/<%= project.image %>" alt="<%= project['title_' + lang] %>" class="w-full h-56 object-cover transition-transform duration-500 hover:scale-105">
                                <div class="project-overlay absolute inset-0 bg-black/70 backdrop-blur-xs flex items-center justify-center opacity-0 transition-opacity duration-300">
                                    <a href="<%= project.github_url %>" target="_blank" class="inline-block bg-accent text-white font-bold py-2.5 px-6 rounded-full shadow-lg"><i class="fab fa-github mr-2"></i>View GitHub</a>
                                </div>
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-bold mb-2 text-white"><%= project['title_' + lang] %></h3>
                                <p class="text-slate-300 text-sm mb-4 line-clamp-3"><%= project['description_' + lang] %></p>
                            </div>
                        </div>
                        <div class="p-6 pt-0">
                            <div class="flex flex-wrap gap-2">
                                <% project.technologies.forEach(tech => { %>
                                    <span class="bg-accent/20 border border-accent/40 text-accent px-3 py-1 rounded-full text-xs font-semibold"><%= tech %></span>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- EXPERIENCE SECTION -->
    <section id="experience" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-accent reveal"><%= t.experience %></h2>
            <div class="relative border-l-2 border-accent/40 ml-3 md:ml-6 pl-6 space-y-10">
                <% experience.forEach((exp, i) => { %>
                    <div class="relative reveal">
                        <div class="absolute -left-[31px] top-1.5 h-5 w-5 rounded-full bg-accent flex items-center justify-center shadow-lg"><div class="h-2 w-2 rounded-full bg-white"></div></div>
                        <div class="timeline-card glass-card p-6 rounded-2xl">
                            <h3 class="text-xl font-bold text-white mb-1">
                                <% if (exp.company_url) { %>
                                    <a class="text-accent hover:underline" target="_blank" href="<%= exp.company_url %>"><%= exp['company_' + lang] %></a>
                                <% } else { %>
                                    <%= exp['company_' + lang] %>
                                <% } %>
                            </h3>
                            <p class="text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wider"><%= exp['period_' + lang] %> • <%= exp['position_' + lang] %></p>
                            <p class="text-slate-300 text-sm leading-relaxed"><%= exp['description_' + lang] %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- EDUCATION SECTION -->
    <section id="education" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-accent reveal"><%= t.education %></h2>
            <div class="relative border-l-2 border-accent/40 ml-3 md:ml-6 pl-6 space-y-10">
                <% education.forEach((edu, i) => { %>
                    <div class="relative reveal">
                        <div class="absolute -left-[31px] top-1.5 h-5 w-5 rounded-full bg-accent flex items-center justify-center shadow-lg"><div class="h-2 w-2 rounded-full bg-white"></div></div>
                        <div class="timeline-card glass-card p-6 rounded-2xl">
                            <h3 class="text-xl font-bold text-white mb-1">
                                <% if (edu.institution_url) { %>
                                    <a class="text-accent hover:underline" target="_blank" href="<%= edu.institution_url %>"><%= edu['institution_' + lang] %></a>
                                <% } else { %>
                                    <%= edu['institution_' + lang] %>
                                <% } %>
                            </h3>
                            <p class="text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wider"><%= edu['period_' + lang] %> • <%= edu['degree_' + lang] %></p>
                            <p class="text-slate-300 text-sm leading-relaxed"><%= edu['description_' + lang] %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="py-24 relative z-20">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-white reveal"><%= t.contactMe %></h2>
            <div class="flex flex-col md:flex-row gap-8">
                <div class="md:w-1/2 reveal-left">
                    <div class="glass-card p-8 rounded-3xl space-y-6">
                        <h3 class="text-xl font-bold text-white mb-6 border-b border-white/10 pb-3"><%= t.contactInfo %></h3>
                        <div class="space-y-5 text-sm text-slate-300">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl bg-accent/20 text-accent flex items-center justify-center text-lg"><i class="fas fa-map-marker-alt"></i></div>
                                <div><h4 class="font-semibold text-white"><%= t.address %></h4><a class="text-accent hover:underline" href="<%= settings.location_url %>" target="_blank"><%= settings['location_' + lang] %></a></div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl bg-accent/20 text-accent flex items-center justify-center text-lg"><i class="fas fa-envelope"></i></div>
                                <div>
                                    <h4 class="font-semibold text-white"><%= t.emailLabel %></h4>
                                    <a class="text-accent hover:underline" href="mailto:<%= settings.email_1 %>"><%= settings.email_1 %></a>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl bg-accent/20 text-accent flex items-center justify-center text-lg"><i class="fas fa-phone"></i></div>
                                <div><h4 class="font-semibold text-white"><%= t.phoneLabel %></h4><a class="text-accent hover:underline" href="tel:<%= settings.phone %>"><%= settings.phone_display %></a></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="md:w-1/2 reveal-right">
                    <form class="glass-card p-8 rounded-3xl space-y-5">
                        <h3 class="text-xl font-bold text-white mb-4 border-b border-white/10 pb-3"><%= t.sendMessage %></h3>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-2"><%= t.nameLabel %></label>
                            <input type="text" required class="w-full bg-black/40 border border-white/10 focus:border-accent rounded-xl px-4 py-3 text-sm text-white outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-2"><%= t.emailLabel %></label>
                            <input type="email" required class="w-full bg-black/40 border border-white/10 focus:border-accent rounded-xl px-4 py-3 text-sm text-white outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-2"><%= t.messageLabel %></label>
                            <textarea rows="4" required class="w-full bg-black/40 border border-white/10 focus:border-accent rounded-xl px-4 py-3 text-sm text-white outline-none"></textarea>
                        </div>
                        <button type="submit" class="w-full py-4 rounded-xl bg-accent hover:opacity-90 text-white font-bold text-sm uppercase tracking-wider transition-all shadow-lg shadow-blue-600/30">
                            <%= t.sendBtn %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script src="/js/index.js"></script>
</body>
</html>
