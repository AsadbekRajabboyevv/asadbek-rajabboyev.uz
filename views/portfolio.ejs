<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-gray-100">
    <div id="scroll-progress"></div>
    <button id="back-to-top" aria-label="Back to top"><i class="fas fa-chevron-up"></i></button>
    <div id="cursor-glow"></div>
    <%- include('partials/birthday') %>
    <%- include('partials/header') %>

    <!-- HOME SECTION -->
    <section id="home" class="gradient-bg text-white min-h-screen flex items-center pt-16">
        <div class="container mx-auto px-4 py-16 md:py-32">
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 text-center md:text-left mb-10 md:mb-0">
                    <h1 class="text-4xl md:text-6xl font-bold mb-4">
                        <span><%= t.helloIm %></span>
                        <span class="block text-blue-300 mt-2"><%= settings.full_name %></span>
                    </h1>
                    <p class="text-xl md:text-2xl mb-8">
                        <span class="typing-text"><%= settings['job_title_' + lang] %></span>
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
                        <a href="#contact" class="bg-accent hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-full transition duration-300 text-center"><%= t.contactMe %></a>
                        <a href="#about" class="bg-transparent hover:bg-white hover:text-accent text-white font-bold py-3 px-6 rounded-full border-2 border-white transition duration-300 text-center"><%= t.aboutMe %></a>
                    </div>
                </div>
                <div class="md:w-1/2 flex justify-center reveal-scale">
                    <img src="/uploads/<%= settings.profile_image %>" class="w-64 h-64 md:w-80 md:h-80 object-cover object-center animate-float" alt="<%= settings.full_name %>">
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section id="about" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-accent reveal"><%= t.aboutMe %></h2>
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/3 mb-8 md:mb-0 reveal-left">
                    <div class="bg-gray-200 p-6 rounded-lg shadow-lg">
                        <h3 class="text-xl font-semibold mb-4 text-primary"><%= t.personalInfo %></h3>
                        <ul class="space-y-2">
                            <li><span class="font-medium text-accent"><%= t.name %>:</span> <%= settings.full_name %></li>
                            <li><span class="font-medium text-accent"><%= t.born %>:</span> <%= settings.birth_date %></li>
                            <li><span class="font-medium text-accent"><%= t.location %>:</span> <a href="<%= settings.location_url %>" target="_blank" class="text-blue-400 hover:underline"><%= settings['location_' + lang] %></a></li>
                            <li><span class="font-medium text-accent"><%= t.currentJob %>:</span> <a href="<%= settings.company_url %>" target="_blank" class="text-blue-400 hover:underline"><%= settings.current_company %></a></li>
                            <li><span class="font-medium text-accent"><%= t.positionLabel %>:</span> <%= settings['position_' + lang] %></li>
                        </ul>
                    </div>
                </div>
                <div class="md:w-2/3 md:pl-8 reveal-right">
                    <% about.forEach((p, i) => { %>
                        <p class="text-gray-700 <%= i < about.length - 1 ? 'mb-4' : '' %> leading-relaxed"><%= p['text_' + lang] %></p>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>

    <!-- SKILLS SECTION -->
    <section id="skills" class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-accent reveal"><%= t.skills %></h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% skills.forEach((skill, i) => { %>
                    <div class="skill-card bg-white p-6 rounded-lg shadow-md reveal stagger-<%= (i % 12) + 1 %>">
                        <div class="text-accent text-4xl mb-4"><i class="<%= skill.icon_class %>"></i></div>
                        <h3 class="text-lg font-semibold mb-2"><%= skill.name %></h3>
                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                            <div class="skill-bar-fill bg-accent h-2.5 rounded-full" style="--target-width:<%= skill.percentage %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- PROJECTS SECTION -->
    <section id="projects" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-accent reveal"><%= t.projects %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% projects.forEach((project, i) => { %>
                    <div class="project-card-wrapper bg-gray-100 rounded-lg overflow-hidden shadow-lg reveal stagger-<%= (i % 12) + 1 %>">
                        <div class="relative project-card">
                            <img src="/uploads/<%= project.image %>" alt="<%= project['title_' + lang] %>" class="w-full h-64 object-cover">
                            <div class="project-overlay absolute inset-0 bg-accent bg-opacity-80 flex items-center justify-center opacity-0 transition-opacity duration-300">
                                <a href="<%= project.github_url %>" target="_blank" class="inline-block bg-white text-accent hover:bg-gray-200 font-bold py-2 px-4 rounded-full"><i class="fab fa-github mr-2"></i>View on GitHub</a>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold mb-2"><%= project['title_' + lang] %></h3>
                            <p class="text-gray-700 mb-4"><%= project['description_' + lang] %></p>
                            <div class="flex flex-wrap gap-2">
                                <% project.technologies.forEach(tech => { %>
                                    <span class="bg-accent text-white px-2 py-1 rounded-full text-xs"><%= tech %></span>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- EXPERIENCE SECTION -->
    <section id="experience" class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-accent reveal"><%= t.experience %></h2>
            <div class="relative border-l-4 border-accent ml-3 md:ml-6 pl-6 space-y-10">
                <% experience.forEach((exp, i) => { %>
                    <div class="relative reveal">
                        <div class="absolute -left-10 mt-1.5 h-6 w-6 rounded-full bg-accent flex items-center justify-center"><div class="h-3 w-3 rounded-full bg-white"></div></div>
                        <div class="timeline-card bg-white p-6 rounded-lg shadow-md">
                            <h3 class="text-xl font-bold text-primary">
                                <% if (exp.company_url) { %>
                                    <a class="text-blue-500 hover:underline" target="_blank" href="<%= exp.company_url %>"><%= exp['company_' + lang] %></a>
                                <% } else { %>
                                    <%= exp['company_' + lang] %>
                                <% } %>
                            </h3>
                            <p class="text-gray-600 mb-2"><%= exp['period_' + lang] %></p>
                            <p class="text-gray-600 mb-4 font-medium"><%= exp['position_' + lang] %></p>
                            <p class="text-gray-700"><%= exp['description_' + lang] %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- EDUCATION SECTION -->
    <section id="education" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-accent reveal"><%= t.education %></h2>
            <div class="relative border-l-4 border-accent ml-3 md:ml-6 pl-6 space-y-10">
                <% education.forEach((edu, i) => { %>
                    <div class="relative reveal">
                        <div class="absolute -left-10 mt-1.5 h-6 w-6 rounded-full bg-accent flex items-center justify-center"><div class="h-3 w-3 rounded-full bg-white"></div></div>
                        <div class="timeline-card bg-white p-6 rounded-lg shadow-md">
                            <h3 class="text-xl font-bold text-primary">
                                <% if (edu.institution_url) { %>
                                    <a class="text-blue-500 hover:underline" target="_blank" href="<%= edu.institution_url %>"><%= edu['institution_' + lang] %></a>
                                <% } else { %>
                                    <%= edu['institution_' + lang] %>
                                <% } %>
                            </h3>
                            <p class="text-gray-600 mb-2"><%= edu['period_' + lang] %></p>
                            <p class="text-gray-600 mb-4 font-medium"><%= edu['degree_' + lang] %></p>
                            <p class="text-gray-700"><%= edu['description_' + lang] %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="py-16 gradient-bg text-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 reveal"><%= t.contactMe %></h2>
            <div class="flex flex-col md:flex-row">
                <div class="md:w-1/2 mb-8 md:mb-0 reveal-left">
                    <div class="bg-white bg-opacity-10 p-6 rounded-lg">
                        <h3 class="text-xl font-semibold mb-6"><%= t.contactInfo %></h3>
                        <div class="space-y-4">
                            <div class="flex items-center">
                                <div class="text-2xl mr-4"><i class="fas fa-map-marker-alt"></i></div>
                                <div><h4 class="font-medium"><%= t.address %></h4><a class="text-blue-400 hover:underline" href="<%= settings.location_url %>" target="_blank"><%= settings['location_' + lang] %></a></div>
                            </div>
                            <div class="flex items-center">
                                <div class="text-2xl mr-4"><i class="fas fa-envelope"></i></div>
                                <div>
                                    <h4 class="font-medium"><%= t.emailLabel %></h4>
                                    <a class="text-blue-400 hover:underline" href="mailto:<%= settings.email_1 %>"><%= settings.email_1 %></a><br>
                                    <% if (settings.email_2) { %>
                                    <a class="text-blue-400 hover:underline" href="mailto:<%= settings.email_2 %>"><%= settings.email_2 %></a>
                                    <% } %>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <div class="text-2xl mr-4"><i class="fas fa-phone"></i></div>
                                <div><h4 class="font-medium"><%= t.phoneLabel %></h4><a class="text-blue-400 hover:underline" href="tel:<%= settings.phone %>"><%= settings.phone_display %></a></div>
                            </div>
                        </div>
                        <div class="mt-8">
                            <h3 class="text-xl font-semibold mb-4"><%= t.socialMedia %></h3>
                            <div class="flex space-x-4">
                                <% if (settings.linkedin) { %>
                                <a href="<%= settings.linkedin %>" aria-label="LinkedIn" class="text-2xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-linkedin"></i></a>
                                <% } %>
                                <% if (settings.github) { %>
                                <a href="<%= settings.github %>" aria-label="GitHub" class="text-2xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-github"></i></a>
                                <% } %>
                                <% if (settings.telegram) { %>
                                <a href="<%= settings.telegram %>" aria-label="Telegram" class="text-2xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-telegram"></i></a>
                                <% } %>
                                <% if (settings.instagram) { %>
                                <a href="<%= settings.instagram %>" aria-label="Instagram" class="text-2xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-instagram"></i></a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2 md:pl-8 reveal-right">
                    <form class="bg-white bg-opacity-10 p-6 rounded-lg">
                        <h3 class="text-xl font-semibold mb-6"><%= t.sendMessage %></h3>
                        <div class="mb-4"><label for="name" class="block mb-2"><%= t.nameLabel %></label><input type="text" id="name" class="w-full px-4 py-2 rounded bg-white bg-opacity-20 border border-white border-opacity-30 focus:outline-none focus:border-blue-300" required></div>
                        <div class="mb-4"><label for="email" class="block mb-2"><%= t.emailLabel %></label><input type="email" id="email" class="w-full px-4 py-2 rounded bg-white bg-opacity-20 border border-white border-opacity-30 focus:outline-none focus:border-blue-300" required></div>
                        <div class="mb-4"><label for="subject" class="block mb-2"><%= t.subjectLabel %></label><input type="text" id="subject" class="w-full px-4 py-2 rounded bg-white bg-opacity-20 border border-white border-opacity-30 focus:outline-none focus:border-blue-300" required></div>
                        <div class="mb-6"><label for="message" class="block mb-2"><%= t.messageLabel %></label><textarea id="message" rows="4" class="w-full px-4 py-2 rounded bg-white bg-opacity-20 border border-white border-opacity-30 focus:outline-none focus:border-blue-300" required></textarea></div>
                        <button type="submit" class="bg-white text-accent hover:bg-blue-100 font-bold py-2 px-6 rounded-full transition duration-300"><%= t.sendBtn %></button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script src="/js/index.js"></script>
    <% if (settings.music_file) { %>
    <audio autoplay loop><source src="/uploads/<%= settings.music_file %>" type="audio/mpeg"></audio>
    <% } %>
</body>
</html>
