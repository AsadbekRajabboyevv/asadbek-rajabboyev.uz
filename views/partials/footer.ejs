    <footer class="bg-primary text-white py-8">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-4 md:mb-0">
                    <h3 class="text-xl font-bold"><%= settings.full_name %></h3>
                    <p class="text-sm text-gray-300">© <%= new Date().getFullYear() %> <%= t.allRights %></p>
                </div>
                <div class="flex space-x-4">
                    <% if (settings.linkedin) { %>
                    <a href="<%= settings.linkedin %>" aria-label="LinkedIn" class="text-xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-linkedin"></i></a>
                    <% } %>
                    <% if (settings.github) { %>
                    <a href="<%= settings.github %>" aria-label="GitHub" class="text-xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-github"></i></a>
                    <% } %>
                    <% if (settings.telegram) { %>
                    <a href="<%= settings.telegram %>" aria-label="Telegram" class="text-xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-telegram"></i></a>
                    <% } %>
                    <% if (settings.instagram) { %>
                    <a href="<%= settings.instagram %>" aria-label="Instagram" class="text-xl hover:text-blue-300 transition hover:scale-125 inline-block"><i class="fab fa-instagram"></i></a>
                    <% } %>
                </div>
            </div>
        </div>
    </footer>
