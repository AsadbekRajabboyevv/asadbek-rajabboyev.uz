    <canvas id="bday-canvas" style="display:none;"></canvas>
    <div id="birthday-overlay" style="display:none;" data-month="<%= settings.birthday_month %>" data-day="<%= settings.birthday_day %>" data-year="<%= settings.launch_year %>">
        <div class="bday-card">
            <div style="font-size:3rem;margin-bottom:0.5rem;">🎂</div>
            <div class="bday-title"><%= t.portfolioBirthday %></div>
            <div class="bday-year" id="bday-year-num">2</div>
            <div class="bday-sub"><%= t.years %><br><%= settings.full_name %> <%= t.portfolio %></div>
            <svg width="80" height="70" viewBox="0 0 80 70" style="margin:0.5rem auto 1rem;display:block;"><rect x="27" y="14" width="26" height="10" rx="3" fill="#ED93B1"/><ellipse cx="40" cy="14" rx="13" ry="4" fill="#F4C0D1"/><rect x="12" y="34" width="56" height="18" rx="5" fill="#378ADD"/><ellipse cx="40" cy="34" rx="28" ry="7" fill="#85B7EB"/><ellipse cx="40" cy="52" rx="28" ry="7" fill="#185FA5"/><text x="40" y="47" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="Poppins,sans-serif" id="cake-year-text">2</text><rect x="37" y="4" width="6" height="12" rx="2" fill="#F4C0D1"/><g class="flame-svg"><ellipse cx="40" cy="2" rx="3.5" ry="5" fill="#EF9F27"/><ellipse cx="40" cy="1" rx="2" ry="3" fill="#FAC775"/></g></svg>
            <button class="bday-close" onclick="closeBirthday()"><%= t.continueBtn %></button>
        </div>
    </div>
