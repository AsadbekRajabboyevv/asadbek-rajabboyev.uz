    <!-- Flash Messages -->
    <div id="flash-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2">
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="flash-message bg-green-500 text-white px-6 py-3 rounded shadow-lg flex items-center justify-between min-w-[300px]">
                <div class="flex items-center"><i class="fas fa-check-circle mr-2"></i> <%= success %></div>
                <button class="close-flash ml-4 text-white hover:text-gray-200"><i class="fas fa-times"></i></button>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="flash-message bg-red-500 text-white px-6 py-3 rounded shadow-lg flex items-center justify-between min-w-[300px]">
                <div class="flex items-center"><i class="fas fa-exclamation-circle mr-2"></i> <%= error %></div>
                <button class="close-flash ml-4 text-white hover:text-gray-200"><i class="fas fa-times"></i></button>
            </div>
        <% } %>
    </div>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 w-64 text-gray-300 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 flex flex-col shadow-xl">
