                <h2 class="text-2xl font-bold mb-6 text-gray-800">Overview</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center">
                        <div class="rounded-full bg-blue-100 p-3 mr-4">
                            <i class="fas fa-user text-blue-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">About Entries</p>
                            <p class="text-2xl font-bold text-gray-800"><%= (typeof about !== 'undefined') ? about.length : 0 %></p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center">
                        <div class="rounded-full bg-green-100 p-3 mr-4">
                            <i class="fas fa-code text-green-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Skills</p>
                            <p class="text-2xl font-bold text-gray-800"><%= (typeof skills !== 'undefined') ? skills.length : 0 %></p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center">
                        <div class="rounded-full bg-purple-100 p-3 mr-4">
                            <i class="fas fa-project-diagram text-purple-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Projects</p>
                            <p class="text-2xl font-bold text-gray-800"><%= (typeof projects !== 'undefined') ? projects.length : 0 %></p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center">
                        <div class="rounded-full bg-orange-100 p-3 mr-4">
                            <i class="fas fa-briefcase text-orange-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Experience</p>
                            <p class="text-2xl font-bold text-gray-800"><%= (typeof experience !== 'undefined') ? experience.length : 0 %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SETTINGS TAB -->
            <div id="settings" class="tab-content">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Site Settings</h2>
                </div>
                
                <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8 border-b border-gray-100 pb-8">
                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">Profile Image</h3>
                            <div class="flex flex-col items-start gap-4">
                                <div class="relative w-32 h-32 rounded-lg border-2 border-dashed border-gray-300 overflow-hidden group bg-gray-50 flex items-center justify-center">
                                    <% if(typeof settings !== 'undefined' && settings.profile_image) { %>
                                        <img src="<%= settings.profile_image %>" id="profile-preview" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <img src="" id="profile-preview" class="w-full h-full object-cover hidden">
                                        <i class="fas fa-image text-gray-400 text-3xl"></i>
                                    <% } %>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Upload New Image</label>
                                    <input type="file" name="profile_image" accept="image/*" data-preview-target="profile-preview" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">Basic Info</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                    <input type="text" name="full_name" value="<%= settings.full_name || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                <div class="grid grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Job Title (EN)</label>
                                        <input type="text" name="job_title_en" value="<%= settings.job_title_en || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Job Title (RU)</label>
                                        <input type="text" name="job_title_ru" value="<%= settings.job_title_ru || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Job Title (UZ)</label>
                                        <input type="text" name="job_title_uz" value="<%= settings.job_title_uz || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8 border-b border-gray-100 pb-8">
                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">Contact & Location</h3>
                            <div class="space-y-4">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Email 1</label>
                                        <input type="email" name="email_1" value="<%= settings.email_1 || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Email 2</label>
                                        <input type="email" name="email_2" value="<%= settings.email_2 || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number (Link)</label>
                                        <input type="text" name="phone" value="<%= settings.phone || '' %>" placeholder="+998901234567" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone (Display)</label>
                                        <input type="text" name="phone_display" value="<%= settings.phone_display || '' %>" placeholder="+998 90 123-45-67" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-3 gap-2">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Location (EN)</label>
                                        <input type="text" name="location_en" value="<%= settings.location_en || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Location (RU)</label>
                                        <input type="text" name="location_ru" value="<%= settings.location_ru || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Location (UZ)</label>
                                        <input type="text" name="location_uz" value="<%= settings.location_uz || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Location Maps URL</label>
                                    <input type="text" name="location_url" value="<%= settings.location_url || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">Social Links</h3>
                            <div class="space-y-4">
                                <div class="flex items-center">
                                    <span class="w-10 text-center text-gray-500"><i class="fab fa-linkedin text-xl"></i></span>
                                    <input type="url" name="linkedin" value="<%= settings.linkedin || '' %>" placeholder="LinkedIn URL" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                                <div class="flex items-center">
                                    <span class="w-10 text-center text-gray-500"><i class="fab fa-github text-xl"></i></span>
                                    <input type="url" name="github" value="<%= settings.github || '' %>" placeholder="GitHub URL" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                                <div class="flex items-center">
                                    <span class="w-10 text-center text-gray-500"><i class="fab fa-telegram text-xl"></i></span>
                                    <input type="url" name="telegram" value="<%= settings.telegram || '' %>" placeholder="Telegram URL" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                                <div class="flex items-center">
                                    <span class="w-10 text-center text-gray-500"><i class="fab fa-instagram text-xl"></i></span>
                                    <input type="url" name="instagram" value="<%= settings.instagram || '' %>" placeholder="Instagram URL" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8 border-b border-gray-100 pb-8">
                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">SEO Settings</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Meta Title (EN, RU, UZ)</label>
                                    <div class="space-y-2">
                                        <input type="text" name="meta_title_en" value="<%= settings.meta_title_en || '' %>" placeholder="EN Title" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                        <input type="text" name="meta_title_ru" value="<%= settings.meta_title_ru || '' %>" placeholder="RU Title" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                        <input type="text" name="meta_title_uz" value="<%= settings.meta_title_uz || '' %>" placeholder="UZ Title" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Meta Description (EN, RU, UZ)</label>
                                    <div class="space-y-2">
                                        <textarea name="meta_description_en" rows="2" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"><%= settings.meta_description_en || '' %></textarea>
                                        <textarea name="meta_description_ru" rows="2" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"><%= settings.meta_description_ru || '' %></textarea>
                                        <textarea name="meta_description_uz" rows="2" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"><%= settings.meta_description_uz || '' %></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <h3 class="text-lg font-semibold mb-4 text-[#00072D] border-b pb-2">Extra Configuration</h3>
                            <div class="space-y-4">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Birthday Month (1-12)</label>
                                        <input type="number" name="birthday_month" value="<%= settings.birthday_month || '1' %>" min="1" max="12" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Birthday Day (1-31)</label>
                                        <input type="number" name="birthday_day" value="<%= settings.birthday_day || '1' %>" min="1" max="31" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Launch Year</label>
                                    <input type="number" name="launch_year" value="<%= settings.launch_year || new Date().getFullYear() %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Music File URL (optional)</label>
                                    <input type="text" name="music_file" value="<%= settings.music_file || '' %>" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition-colors flex items-center shadow-lg shadow-blue-500/30">
                            <i class="fas fa-save mr-2"></i> Save Settings
                        </button>
                    </div>
                </form>
            </div>

            <!-- ABOUT TAB -->
            <div id="about" class="tab-content">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">About Section</h2>
                    <button onclick="document.getElementById('add-about-modal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i class="fas fa-plus mr-1"></i> Add Paragraph
                    </button>
                </div>
                
                <div class="space-y-4">
                    <% if(typeof about !== 'undefined' && about.length > 0) { %>
                        <% about.forEach(item => { %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="text-xs font-semibold bg-gray-100 text-gray-600 px-2 py-1 rounded">Order: <%= item.sort_order %></div>
                                    <div class="flex space-x-2">
                                        <button onclick="document.getElementById('edit-about-<%= item.id %>').classList.remove('hidden')" class="text-blue-500 hover:text-blue-700 bg-blue-50 p-2 rounded">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form action="/admin/about/delete/<%= item.id %>" method="POST" class="delete-form inline">
                                            <button type="submit" class="text-red-500 hover:text-red-700 bg-red-50 p-2 rounded">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div class="space-y-3 text-sm">
                                    <p><strong class="text-gray-700">EN:</strong> <%= item.text_en %></p>
                                    <p><strong class="text-gray-700">RU:</strong> <%= item.text_ru %></p>
                                    <p><strong class="text-gray-700">UZ:</strong> <%= item.text_uz %></p>
                                </div>
                                
                                <!-- Edit Modal -->
                                <div id="edit-about-<%= item.id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-2xl">
                                        <h3 class="text-xl font-bold mb-4">Edit Paragraph</h3>
                                        <form action="/admin/about/update/<%= item.id %>" method="POST" class="space-y-4">
                                            <div><label class="block text-sm font-medium mb-1">Text (EN)</label><textarea name="text_en" rows="3" required class="w-full rounded border px-3 py-2 text-sm"><%= item.text_en %></textarea></div>
                                            <div><label class="block text-sm font-medium mb-1">Text (RU)</label><textarea name="text_ru" rows="3" required class="w-full rounded border px-3 py-2 text-sm"><%= item.text_ru %></textarea></div>
                                            <div><label class="block text-sm font-medium mb-1">Text (UZ)</label><textarea name="text_uz" rows="3" required class="w-full rounded border px-3 py-2 text-sm"><%= item.text_uz %></textarea></div>
                                            <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="<%= item.sort_order %>" class="w-32 rounded border px-3 py-2 text-sm"></div>
                                            <div class="flex justify-end space-x-3 mt-6">
                                                <button type="button" onclick="document.getElementById('edit-about-<%= item.id %>').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="bg-white p-8 rounded-xl border border-gray-100 text-center text-gray-500">No about paragraphs found. Add one!</div>
                    <% } %>
                </div>

                <!-- Add Modal -->
                <div id="add-about-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-2xl">
                        <h3 class="text-xl font-bold mb-4">Add New Paragraph</h3>
                        <form action="/admin/about/create" method="POST" class="space-y-4">
                            <div><label class="block text-sm font-medium mb-1">Text (EN)</label><textarea name="text_en" rows="3" required class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                            <div><label class="block text-sm font-medium mb-1">Text (RU)</label><textarea name="text_ru" rows="3" required class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                            <div><label class="block text-sm font-medium mb-1">Text (UZ)</label><textarea name="text_uz" rows="3" required class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                            <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="0" class="w-32 rounded border px-3 py-2 text-sm"></div>
                            <div class="flex justify-end space-x-3 mt-6">
                                <button type="button" onclick="document.getElementById('add-about-modal').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Add Paragraph</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SKILLS TAB -->
            <div id="skills" class="tab-content">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Skills Management</h2>
                    <button onclick="document.getElementById('add-skill-modal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i class="fas fa-plus mr-1"></i> Add Skill
                    </button>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% if(typeof skills !== 'undefined' && skills.length > 0) { %>
                        <% skills.forEach(item => { %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded flex items-center justify-center text-xl">
                                            <i class="<%= item.icon_class %>"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-gray-800"><%= item.name %></h4>
                                            <div class="text-xs text-gray-500">Order: <%= item.sort_order %></div>
                                        </div>
                                    </div>
                                    <div class="flex space-x-1">
                                        <button onclick="document.getElementById('edit-skill-<%= item.id %>').classList.remove('hidden')" class="text-blue-500 p-1"><i class="fas fa-edit"></i></button>
                                        <form action="/admin/skills/delete/<%= item.id %>" method="POST" class="delete-form inline">
                                            <button type="submit" class="text-red-500 p-1"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                                
                                <div class="w-full bg-gray-200 rounded-full h-2 mb-1">
                                    <div class="bg-blue-600 h-2 rounded-full" style="width: <%= item.percentage %>%"></div>
                                </div>
                                <div class="text-right text-xs font-bold text-gray-600"><%= item.percentage %>%</div>

                                <!-- Edit Modal -->
                                <div id="edit-skill-<%= item.id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md">
                                        <h3 class="text-xl font-bold mb-4">Edit Skill</h3>
                                        <form action="/admin/skills/update/<%= item.id %>" method="POST" class="space-y-4">
                                            <div><label class="block text-sm font-medium mb-1">Name</label><input type="text" name="name" value="<%= item.name %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                            <div>
                                                <label class="block text-sm font-medium mb-1">Icon Class (FontAwesome)</label>
                                                <div class="flex space-x-2">
                                                    <div class="w-10 h-10 border rounded flex items-center justify-center bg-gray-50 text-lg"><i id="edit-icon-prev-<%= item.id %>" class="<%= item.icon_class %>"></i></div>
                                                    <input type="text" name="icon_class" value="<%= item.icon_class %>" required class="icon-input flex-1 rounded border px-3 py-2 text-sm" data-preview-target="edit-icon-prev-<%= item.id %>">
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium mb-1">Percentage: <span id="edit-pct-val-<%= item.id %>"><%= item.percentage %>%</span></label>
                                                <input type="range" name="percentage" min="0" max="100" value="<%= item.percentage %>" class="w-full" data-display-target="edit-pct-val-<%= item.id %>">
                                            </div>
                                            <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="<%= item.sort_order %>" class="w-full rounded border px-3 py-2 text-sm"></div>
                                            <div class="flex justify-end space-x-3 mt-6">
                                                <button type="button" onclick="document.getElementById('edit-skill-<%= item.id %>').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Add Skill Modal -->
                <div id="add-skill-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md">
                        <h3 class="text-xl font-bold mb-4">Add New Skill</h3>
                        <form action="/admin/skills/create" method="POST" class="space-y-4">
                            <div><label class="block text-sm font-medium mb-1">Name</label><input type="text" name="name" required class="w-full rounded border px-3 py-2 text-sm"></div>
                            <div>
                                <label class="block text-sm font-medium mb-1">Icon Class (FontAwesome)</label>
