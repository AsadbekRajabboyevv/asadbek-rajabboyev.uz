    <!-- Main Content Body -->
    <main class="flex-1 p-4 md:p-10 overflow-y-auto max-h-screen">
        <!-- Settings Tab -->
        <div id="tab-settings" class="tab-content space-y-6">
            <h2 class="text-xl md:text-2xl font-bold border-b border-slate-800 pb-3">General Settings</h2>
            <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="space-y-6 max-w-4xl">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 bg-slate-800/40 p-4 md:p-6 rounded-2xl border border-slate-700">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Full Name</label>
                        <input type="text" name="full_name" value="<%= settings.full_name %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Birth Date</label>
                        <input type="text" name="birth_date" value="<%= settings.birth_date %>" placeholder="29 March 2006" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Job Title (EN)</label>
                        <input type="text" name="job_title_en" value="<%= settings.job_title_en %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Job Title (RU)</label>
                        <input type="text" name="job_title_ru" value="<%= settings.job_title_ru %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Job Title (UZ)</label>
                        <input type="text" name="job_title_uz" value="<%= settings.job_title_uz %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Position Label (EN)</label>
                        <input type="text" name="position_en" value="<%= settings.position_en %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Location (EN)</label>
                        <input type="text" name="location_en" value="<%= settings.location_en %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Location Google Map URL</label>
                        <input type="text" name="location_url" value="<%= settings.location_url %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Current Company Name</label>
                        <input type="text" name="current_company" value="<%= settings.current_company %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Current Company URL</label>
                        <input type="text" name="company_url" value="<%= settings.company_url %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Primary Email</label>
                        <input type="email" name="email_1" value="<%= settings.email_1 %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Secondary Email</label>
                        <input type="email" name="email_2" value="<%= settings.email_2 %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1.5">Phone Number</label>
                        <input type="text" name="phone" value="<%= settings.phone %>" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white">
                    </div>
                    <div class="sm:col-span-2">
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-xs font-semibold text-slate-300 uppercase">Active Website Theme</label>
                            <button type="button" onclick="document.getElementById('custom-theme-modal').classList.remove('hidden')" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1.5 bg-blue-900/30 px-3 py-1.5 rounded-lg border border-blue-500/20">
                                <i class="fas fa-plus-circle"></i> Create New Custom Theme
                            </button>
                        </div>
                        <select name="theme" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white outline-none">
                            <% (themes || []).forEach(t => { %>
                                <option value="<%= t.code %>" <%= (settings.theme === t.code || (!settings.theme && t.code === 'cyber_dark')) ? 'selected' : '' %>>
                                    <%= t.name %> <%= t.is_custom ? '🎨 (Custom Created)' : '' %>
                                </option>
                            <% }) %>
                        </select>

                        <!-- Theme Preview Cards Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
                            <% (themes || []).forEach(t => { %>
                                <div class="p-3.5 rounded-xl border <%= settings.theme === t.code ? 'border-blue-500 bg-blue-950/30' : 'border-slate-800 bg-slate-900/40' %> flex flex-col justify-between space-y-3">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-bold text-white flex items-center gap-2">
                                            <span class="w-3 h-3 rounded-full inline-block" style="background-color: <%= t.accent_color %>;"></span>
                                            <%= t.name %>
                                        </span>
                                        <% if (settings.theme === t.code) { %>
                                            <span class="text-[10px] uppercase font-extrabold bg-blue-600 text-white px-2 py-0.5 rounded-full">Active</span>
                                        <% } %>
                                    </div>
                                    <div class="h-6 rounded-lg flex items-center px-3 text-xs justify-between" style="background-color: <%= t.bg_color %>; color: <%= t.fg_color %>; border: 1px solid <%= t.glass_border %>;">
                                        <span>Preview</span>
                                        <span class="font-bold" style="color: <%= t.accent_color %>;">Accent</span>
                                    </div>
                                    <% if (t.is_custom) { %>
                                        <div class="flex justify-end pt-1">
                                            <button type="submit" formaction="/admin/themes/delete/<%= t.id %>" onclick="return confirm('Delete this custom theme?')" class="text-[11px] font-semibold text-rose-400 hover:text-rose-300">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <div class="sm:col-span-2 p-4 bg-slate-900/60 rounded-xl border border-slate-700/60 space-y-3">
                        <label class="block text-xs font-bold text-blue-400 uppercase">Background Music File (MP3 / WAV)</label>
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-music text-blue-400 text-xl"></i>
                                <div>
                                    <p class="text-xs text-slate-300 font-medium">Current Track: <span class="text-blue-300 font-bold"><%= settings.music_file || 'No music uploaded' %></span></p>
                                </div>
                            </div>
                            <input type="file" name="music_file" accept="audio/*" class="block text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500">
                        </div>
                        <% if (settings.music_file) { %>
                            <div class="flex items-center gap-2 pt-2 border-t border-slate-800">
                                <input type="checkbox" name="delete_music" value="1" id="delete_music" class="rounded border-slate-700 text-blue-600">
                                <label for="delete_music" class="text-xs text-rose-400 font-semibold cursor-pointer">Delete current music file</label>
                            </div>
                        <% } %>
                    </div>
                </div>

                <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-blue-600 hover:bg-blue-500 rounded-xl font-bold text-sm text-white shadow-lg transition">Save Settings</button>
            </form>

            <!-- Custom Theme Creator Modal -->
            <div id="custom-theme-modal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-md flex items-center justify-center p-4">
                <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-6 shadow-2xl">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                        <h3 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fas fa-palette text-blue-400"></i> Create Custom Theme
                        </h3>
                        <button type="button" onclick="document.getElementById('custom-theme-modal').classList.add('hidden')" class="text-slate-400 hover:text-white text-lg">&times;</button>
                    </div>

                    <form action="/admin/themes/create" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Theme Name</label>
                            <input type="text" name="name" required placeholder="e.g. Cyberpunk Magenta" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white">
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Background</label>
                                <input type="color" name="bg_color" value="#0d1117" class="w-full h-10 bg-slate-950 border border-slate-700 rounded-xl p-1 cursor-pointer">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Text Color</label>
                                <input type="color" name="fg_color" value="#f0f6fc" class="w-full h-10 bg-slate-950 border border-slate-700 rounded-xl p-1 cursor-pointer">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Accent Color</label>
                                <input type="color" name="accent_color" value="#58a6ff" class="w-full h-10 bg-slate-950 border border-slate-700 rounded-xl p-1 cursor-pointer">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Glass Fill (RGBA CSS)</label>
                            <input type="text" name="glass_bg" value="rgba(22, 27, 34, 0.6)" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Glass Border (RGBA CSS)</label>
                            <input type="text" name="glass_border" value="rgba(56, 139, 253, 0.25)" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white">
                        </div>

                        <div class="flex justify-end gap-3 pt-2">
                            <button type="button" onclick="document.getElementById('custom-theme-modal').classList.add('hidden')" class="px-5 py-2 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-bold text-slate-300">Cancel</button>
                            <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-xl text-xs font-bold text-white shadow-lg">Save & Install Theme</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- About Tab -->
        <div id="tab-about" class="tab-content space-y-6">
            <h2 class="text-xl md:text-2xl font-bold border-b border-slate-800 pb-3">About Paragraphs</h2>
            
            <!-- Add New About Paragraph Form -->
            <div class="bg-blue-950/40 p-4 md:p-6 rounded-2xl border border-blue-500/30 mb-6 max-w-4xl">
                <h3 class="text-base md:text-lg font-bold text-blue-300 mb-3"><i class="fas fa-plus-circle mr-2"></i>Add New Paragraph</h3>
                <form action="/admin/about/create" method="POST" class="space-y-3">
                    <div class="grid grid-cols-1 gap-3">
                        <div><label class="text-xs font-bold text-blue-400">English Text</label><textarea name="text_en" required rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-white"></textarea></div>
                        <div><label class="text-xs font-bold text-blue-400">Russian Text</label><textarea name="text_ru" required rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-white"></textarea></div>
                        <div><label class="text-xs font-bold text-blue-400">Uzbek Text</label><textarea name="text_uz" required rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-white"></textarea></div>
                    </div>
                    <div class="flex items-center justify-between pt-2">
                        <div><label class="text-xs font-bold text-blue-400 mr-2">Sort Order</label><input type="number" name="sort_order" value="0" class="w-20 bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-sm"></div>
                        <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-xl font-bold text-xs text-white shadow-lg">Add Paragraph</button>
                    </div>
                </form>
            </div>

            <!-- Existing Paragraphs List -->
            <div class="space-y-4 max-w-4xl">
                <% about.forEach((p, idx) => { %>
                    <form action="/admin/about/update/<%= p.id %>" method="POST" class="bg-slate-800/40 p-4 md:p-6 rounded-2xl border border-slate-700 space-y-3">
                        <div class="grid grid-cols-1 gap-3">
