                                <div><label class="block text-sm font-medium mb-1">Period (EN)</label><input type="text" name="period_en" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Period (RU)</label><input type="text" name="period_ru" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Period (UZ)</label><input type="text" name="period_uz" required class="w-full rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="grid grid-cols-1 gap-4">
                                <div><label class="block text-sm font-medium mb-1">Company URL</label><input type="url" name="company_url" class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="0" class="w-32 rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="space-y-3 mt-4">
                                <div><label class="block text-sm font-medium mb-1">Description (EN)</label><textarea name="description_en" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                                <div><label class="block text-sm font-medium mb-1">Description (RU)</label><textarea name="description_ru" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                                <div><label class="block text-sm font-medium mb-1">Description (UZ)</label><textarea name="description_uz" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                            </div>
                            <div class="flex justify-end space-x-3 mt-6 pt-4 border-t">
                                <button type="button" onclick="document.getElementById('add-exp-modal').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Add Experience</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- EDUCATION TAB -->
            <div id="education" class="tab-content">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Education Timeline</h2>
                    <button onclick="document.getElementById('add-edu-modal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i class="fas fa-plus mr-1"></i> Add Education
                    </button>
                </div>
                
                <div class="space-y-4">
                    <% if(typeof education !== 'undefined' && education.length > 0) { %>
                        <% education.forEach(item => { %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex flex-col md:flex-row gap-4">
                                <div class="w-full md:w-1/4">
                                    <div class="text-blue-600 font-bold mb-1"><%= item.period_en %></div>
                                    <h4 class="font-bold text-gray-800"><%= item.institution_en %></h4>
                                    <div class="text-sm text-gray-500 font-medium"><%= item.degree_en %></div>
                                    <div class="mt-2 text-xs text-gray-400">Order: <%= item.sort_order %></div>
                                </div>
                                <div class="w-full md:w-3/4 flex justify-between">
                                    <div class="text-sm text-gray-600 max-w-3xl">
                                        <p class="mb-2"><strong>EN:</strong> <%= item.description_en %></p>
                                    </div>
                                    <div class="flex flex-col space-y-2 ml-4">
                                        <button onclick="document.getElementById('edit-edu-<%= item.id %>').classList.remove('hidden')" class="text-blue-500 bg-blue-50 p-2 rounded hover:bg-blue-100"><i class="fas fa-edit"></i></button>
                                        <form action="/admin/education/delete/<%= item.id %>" method="POST" class="delete-form">
                                            <button type="submit" class="text-red-500 bg-red-50 p-2 rounded hover:bg-red-100"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                                
                                <!-- Edit Modal -->
                                <div id="edit-edu-<%= item.id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto">
                                        <h3 class="text-xl font-bold mb-4">Edit Education</h3>
                                        <form action="/admin/education/update/<%= item.id %>" method="POST" class="space-y-4">
                                            <div class="grid grid-cols-3 gap-4">
                                                <div><label class="block text-sm font-medium mb-1">Institution (EN)</label><input type="text" name="institution_en" value="<%= item.institution_en %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Institution (RU)</label><input type="text" name="institution_ru" value="<%= item.institution_ru %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Institution (UZ)</label><input type="text" name="institution_uz" value="<%= item.institution_uz %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                            </div>
                                            <div class="grid grid-cols-3 gap-4">
                                                <div><label class="block text-sm font-medium mb-1">Degree (EN)</label><input type="text" name="degree_en" value="<%= item.degree_en %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Degree (RU)</label><input type="text" name="degree_ru" value="<%= item.degree_ru %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Degree (UZ)</label><input type="text" name="degree_uz" value="<%= item.degree_uz %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                            </div>
                                            <div class="grid grid-cols-3 gap-4">
                                                <div><label class="block text-sm font-medium mb-1">Period (EN)</label><input type="text" name="period_en" value="<%= item.period_en %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Period (RU)</label><input type="text" name="period_ru" value="<%= item.period_ru %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Period (UZ)</label><input type="text" name="period_uz" value="<%= item.period_uz %>" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                            </div>
                                            <div class="grid grid-cols-1 gap-4">
                                                <div><label class="block text-sm font-medium mb-1">Institution URL</label><input type="url" name="institution_url" value="<%= item.institution_url || '' %>" class="w-full rounded border px-3 py-2 text-sm"></div>
                                                <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="<%= item.sort_order %>" class="w-32 rounded border px-3 py-2 text-sm"></div>
                                            </div>
                                            <div class="space-y-3 mt-4">
                                                <div><label class="block text-sm font-medium mb-1">Description (EN)</label><textarea name="description_en" rows="2" class="w-full rounded border px-3 py-2 text-sm"><%= item.description_en %></textarea></div>
                                                <div><label class="block text-sm font-medium mb-1">Description (RU)</label><textarea name="description_ru" rows="2" class="w-full rounded border px-3 py-2 text-sm"><%= item.description_ru %></textarea></div>
                                                <div><label class="block text-sm font-medium mb-1">Description (UZ)</label><textarea name="description_uz" rows="2" class="w-full rounded border px-3 py-2 text-sm"><%= item.description_uz %></textarea></div>
                                            </div>
                                            <div class="flex justify-end space-x-3 mt-6 pt-4 border-t">
                                                <button type="button" onclick="document.getElementById('edit-edu-<%= item.id %>').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Add Education Modal -->
                <div id="add-edu-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
                    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto">
                        <h3 class="text-xl font-bold mb-4">Add Education</h3>
                        <form action="/admin/education/create" method="POST" class="space-y-4">
                            <div class="grid grid-cols-3 gap-4">
                                <div><label class="block text-sm font-medium mb-1">Institution (EN)</label><input type="text" name="institution_en" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Institution (RU)</label><input type="text" name="institution_ru" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Institution (UZ)</label><input type="text" name="institution_uz" required class="w-full rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="grid grid-cols-3 gap-4">
                                <div><label class="block text-sm font-medium mb-1">Degree (EN)</label><input type="text" name="degree_en" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Degree (RU)</label><input type="text" name="degree_ru" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Degree (UZ)</label><input type="text" name="degree_uz" required class="w-full rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="grid grid-cols-3 gap-4">
                                <div><label class="block text-sm font-medium mb-1">Period (EN)</label><input type="text" name="period_en" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Period (RU)</label><input type="text" name="period_ru" required class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Period (UZ)</label><input type="text" name="period_uz" required class="w-full rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="grid grid-cols-1 gap-4">
                                <div><label class="block text-sm font-medium mb-1">Institution URL</label><input type="url" name="institution_url" class="w-full rounded border px-3 py-2 text-sm"></div>
                                <div><label class="block text-sm font-medium mb-1">Sort Order</label><input type="number" name="sort_order" value="0" class="w-32 rounded border px-3 py-2 text-sm"></div>
                            </div>
                            <div class="space-y-3 mt-4">
                                <div><label class="block text-sm font-medium mb-1">Description (EN)</label><textarea name="description_en" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                                <div><label class="block text-sm font-medium mb-1">Description (RU)</label><textarea name="description_ru" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                                <div><label class="block text-sm font-medium mb-1">Description (UZ)</label><textarea name="description_uz" rows="2" class="w-full rounded border px-3 py-2 text-sm"></textarea></div>
                            </div>
                            <div class="flex justify-end space-x-3 mt-6 pt-4 border-t">
                                <button type="button" onclick="document.getElementById('add-edu-modal').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Cancel</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Add Education</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="/js/admin.js"></script>
</body>
</html>
