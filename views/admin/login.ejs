<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Portfolio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#00072D] text-white font-['Poppins'] flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md p-8 rounded-3xl bg-[#051650]/40 backdrop-blur-xl border border-blue-400/20 shadow-2xl">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-lg shadow-blue-500/50">AR</div>
            <h1 class="text-2xl font-bold">Admin Portal</h1>
            <p class="text-xs text-blue-300">Dynamic Portfolio Control Center</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 p-3 bg-red-500/20 border border-red-500/40 rounded-xl text-red-300 text-xs text-center font-medium">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Username</label>
                <div class="relative">
                    <i class="fas fa-user absolute left-4 top-3.5 text-blue-400 text-sm"></i>
                    <input type="text" name="username" required class="w-full bg-slate-900/60 border border-slate-700 focus:border-blue-400 rounded-xl pl-11 pr-4 py-3 text-sm text-white outline-none transition">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Password</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-3.5 text-blue-400 text-sm"></i>
                    <input type="password" name="password" required class="w-full bg-slate-900/60 border border-slate-700 focus:border-blue-400 rounded-xl pl-11 pr-4 py-3 text-sm text-white outline-none transition">
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm uppercase tracking-wider transition-all shadow-lg shadow-blue-600/40">
                Log In
            </button>
        </form>
    </div>
</body>
</html>
